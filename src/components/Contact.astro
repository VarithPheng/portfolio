---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/profile";
---

<section id="contact" class="shell">
<div class="border-t border-rule py-20 lg:py-32">
  <h2 class="heading">Contact</h2>
  <p class="mt-4 max-w-[40ch] text-mute">Have a project, a role or a question? Send me an email.</p>

  <a
    href={`mailto:${contact.email}`}
    class="display mt-10 block text-[12.5vw] text-white transition-colors hover:text-paper lg:text-[min(10vw,8.5rem)]"
  >
    {contact.email}
  </a>

  <button type="button" class="btn btn-line mt-8" data-copy={contact.email}>
    <Icon name="lucide:copy" class="size-4" aria-hidden="true" data-icon-idle />
    <Icon name="lucide:check" class="hidden size-4" aria-hidden="true" data-icon-done />
    <span data-copy-label>Copy email</span>
  </button>

  <ul class="mt-16 grid gap-px overflow-hidden rounded-md border border-rule bg-rule lg:grid-cols-4">
    <li>
      <a href={`tel:${contact.phone.replaceAll(" ", "")}`} class="flex h-full flex-col gap-1 bg-ink p-5 transition-colors hover:bg-panel">
        <span class="inline-flex items-center gap-2 text-sm text-mute">
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" /> Phone
        </span>
        <span class="text-white tabular-nums">{contact.phone}</span>
      </a>
    </li>
    {
      contact.links.map((l) => (
        <li>
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-full flex-col gap-1 bg-ink p-5 transition-colors hover:bg-panel"
          >
            <span class="inline-flex items-center gap-2 text-sm text-mute">
              <Icon name={l.icon} class="size-4" aria-hidden="true" /> {l.label}
            </span>
            <span class="text-white">{l.handle}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const label = btn?.querySelector("[data-copy-label]");
  const idle = btn?.querySelector("[data-icon-idle]");
  const done = btn?.querySelector("[data-icon-done]");
  let timer: ReturnType<typeof setTimeout>;

  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
    } catch {
      if (label) label.textContent = "Copy failed. Select the address above.";
      return;
    }
    if (label) label.textContent = "Copied";
    idle?.classList.add("hidden");
    done?.classList.remove("hidden");
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (label) label.textContent = "Copy email";
      idle?.classList.remove("hidden");
      done?.classList.add("hidden");
    }, 2000);
  });
</script>
