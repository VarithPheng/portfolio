---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="contact" title="4:contact" class="mt-16 lg:mt-24">
  <div>
    <p class="max-w-[40ch] text-mute">
      Hiring, or have a project in mind? Email is the fastest way to reach me.
    </p>

    <a
      href={`mailto:${contact.email}`}
      class="display mt-8 block text-[12.5vw] text-white transition-colors hover:text-paper lg:text-[clamp(4rem,6vw,6rem)]"
    >
      {contact.email}
    </a>

    <button type="button" class="btn btn-line mt-8" data-copy={contact.email}>
      <Icon
        name="lucide:copy"
        class="size-4"
        aria-hidden="true"
        data-icon-idle
      />
      <Icon
        name="lucide:check"
        class="hidden size-4"
        aria-hidden="true"
        data-icon-done
      />
      <span data-copy-label>Copy email</span>
    </button>

    <ul class="mt-10 grid gap-3 lg:grid-cols-3">
      {
        contact.links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-full flex-col gap-1 rounded-lg border border-white/10 bg-white/[0.03] p-4 transition-colors hover:border-white/30 hover:bg-white/[0.07]"
            >
              <span class="mono inline-flex items-center gap-2 text-mute">
                <Icon name={l.icon} class="size-4" style={`color: ${l.color}`} aria-hidden="true" />{" "}
                {l.label}
              </span>
              <span class="text-white">{l.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</Pane>

<p class="mono mt-6 pb-24 text-mute">© {new Date().getFullYear()} Varith Pheng. Built with Astro.</p>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const label = btn?.querySelector("[data-copy-label]");
  const idle = btn?.querySelector("[data-icon-idle]");
  const done = btn?.querySelector("[data-icon-done]");
  let timer: ReturnType<typeof setTimeout>;

  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
    } catch {
      if (label) label.textContent = "Copy failed. Select the address above.";
      return;
    }
    if (label) label.textContent = "Copied";
    idle?.classList.add("hidden");
    done?.classList.remove("hidden");
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (label) label.textContent = "Copy email";
      idle?.classList.remove("hidden");
      done?.classList.add("hidden");
    }, 2000);
  });
</script>
