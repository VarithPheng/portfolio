---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/profile";

const github = contact.links.find((l) => l.label === "GitHub")!;
---

<section id="projects" class="shell">
  <div class="grid gap-10 py-20 lg:grid-cols-12 lg:py-32">
    <div class="lg:col-span-4">
      <h2 class="heading">Projects</h2>
    </div>

    <div class="rounded-md border border-dashed border-rule p-8 lg:col-span-8 lg:p-12">
      <p class="display text-3xl text-white lg:text-[5.5rem]">Coming soon</p>
      <p class="mt-5 max-w-[44ch] text-mute">
        I'm writing up case studies for the things I've built. Until they're here, you can browse my code on GitHub.
      </p>
      <a href={github.href} target="_blank" rel="noopener noreferrer" class="btn btn-line mt-8">
        <Icon name={github.icon} class="size-4" aria-hidden="true" />
        View GitHub
      </a>
    </div>
  </div>
</section>
