                <p class="mt-2 text-lg text-white lg:mt-0">{p.summary}</p>
                <ul class="mt-6 space-y-3 text-paper">
                  {p.details.map((d) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.7em] h-px w-3 shrink-0 bg-mute" aria-hidden="true" />
                      {d}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-col gap-6 lg:col-span-4 lg:col-start-9">
                <div>
                  <h3 class="mono text-mute">built with</h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {p.stack.map((name) => {
                      const logo = findLogo(name);
                      return (
                        <li class="glass inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm text-white">
                          {logo && <Icon name={logo.icon} class="size-4" style={`color: ${logo.color}`} aria-hidden="true" />}
                          {name}
                        </li>
                      );
                    })}
                  </ul>
                </div>
                <div class="flex flex-wrap gap-3">
                  {p.links.map((l, j) => {
                    const external = l.href.startsWith("http");
                    return (
                      <a
                        href={l.href}
                        class:list={["btn", j === 0 ? "btn-solid" : "btn-line"]}
                        {...(external && { target: "_blank", rel: "noopener noreferrer" })}
                      >
                        {l.label === "Source" && <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />}
                        {l.label}
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          </details>
        </li>
      ))
