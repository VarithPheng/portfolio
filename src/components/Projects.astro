---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/profile";

const github = contact.links.find((l) => l.label === "GitHub")!;
---

<section id="projects" class="shell">
  <div class="grid gap-10 pt-12 lg:grid-cols-12 lg:pt-20">
    <div class="lg:col-span-4">
      <h2 class="heading">Projects</h2>
    </div>

    <div class="flex flex-col items-start gap-5 border-y border-white/10 py-6 lg:col-span-8 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
      <p class="max-w-[44ch] text-lg text-paper">
        Case studies are on the way. Until then, my code is on GitHub.
      </p>
      <a href={github.href} target="_blank" rel="noopener noreferrer" class="btn btn-line shrink-0">
        <Icon name={github.icon} class="size-4" aria-hidden="true" />
        View GitHub
      </a>
    </div>
  </div>
</section>
