---
import { Icon } from "astro-icon/components";
import { findLogo, projects } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="work" title="1:work" class="mt-20 lg:mt-28">
  <p class="text-lg text-paper">Coming soon.</p>

