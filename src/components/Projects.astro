  </ul>
  */}
</Pane>

<style>
  /* Titles sit condensed and open up wider when a row is opened or pointed at. */
  .title {
    transition:
      font-stretch 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.3s;
  }
  @media (min-width: 64rem) {
    .project[open] .title {
      font-stretch: 78%;
    }
  }
  .project:not([open]) .title {
    color: var(--color-mute);
  }
  /* Pointing at a row inverts it, like the cursor line in a TUI list. */
  .row {
    transition: background-color 0.2s;
  }
  @media (hover: hover) {
    .row:hover {
      background: var(--color-white);
    }
    .row:hover .title,
    .row:hover .meta,
    .row:hover .meta * {
      color: var(--color-ink);
    }
  }
  @media (hover: hover) and (min-width: 64rem) {
    .row:hover .title {
      font-stretch: 78%;
    }
  }
  .project summary::-webkit-details-marker {
    display: none;
  }
  .project summary:focus-visible {
    outline-offset: -2px;
  }
</style>
