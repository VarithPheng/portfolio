---
import { Icon } from "astro-icon/components";
import { tools } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="stack" title="2:stack" meta={`${tools.length} tools`} class="mt-16 lg:mt-24">
  <ul class="grid grid-cols-2 gap-2 lg:grid-cols-4 lg:gap-3">
    {
      tools.map((t) => (
        <li class="tile relative flex items-center gap-3 overflow-hidden rounded-lg border border-white/10 bg-white/[0.03] p-3.5 lg:block lg:p-5" style={`--brand: ${t.color}`}>
          <Icon name={t.icon} class="relative size-7 shrink-0 lg:size-10" style={`color: ${t.color}`} aria-hidden="true" />
          <div class="relative min-w-0 lg:mt-6">
            <p class="text-sm text-white lg:text-base">{t.name}</p>
            <p class="mono mt-1 hidden text-mute lg:block">{t.type.toLowerCase()}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Pane>

<style>
  /* Each tile catches a soft glow in its brand colour when pointed at. */
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(14rem 10rem at 0% 0%, color-mix(in srgb, var(--brand) 28%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tile:hover::before {
    opacity: 1;
  }
</style>
