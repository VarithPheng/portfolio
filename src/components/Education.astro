---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
---

<section id="education" class="shell">
  <div class="border-t border-rule py-20 lg:py-32">
    <div>
      <h2 class="heading">Education</h2>
      <p class="mt-4 max-w-[30ch] text-mute">Two bachelor's degrees, studied side by side.</p>
    </div>

    <ul class="mt-10 divide-y divide-rule lg:mt-14">
      {
        education.map((e) => (
          <li class="flex items-center gap-5 py-6 first:pt-0 last:pb-0 lg:gap-8">
            <div class="shrink-0 rounded-md bg-white px-3 py-2 lg:px-4 lg:py-3">
              <Image src={e.logo} alt={e.school} height={48} densities={[1, 2]} class="h-7 w-auto grayscale lg:h-10" />
            </div>
            <div class="min-w-0 flex-1 lg:flex lg:items-center lg:justify-between lg:gap-8">
              <p class="text-white">{e.degree}</p>
              <p class="text-sm whitespace-nowrap text-mute">{e.years}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
