---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
---

<section id="education" class="shell">
  <div class="grid gap-10 pt-12 lg:grid-cols-12 lg:pt-20">
    <div class="lg:col-span-4">
      <h2 class="heading">Education</h2>
    </div>

    <ul class="glass divide-y divide-white/10 rounded-3xl px-6 py-2 lg:col-span-8 lg:px-10 lg:py-4">
      {
        education.map((e) => (
          <li class="flex flex-col items-start gap-4 py-5 lg:flex-row lg:items-center lg:gap-6 lg:py-6">
            <div class="shrink-0 rounded-xl bg-white px-3 py-2">
              <Image src={e.logo} alt={e.school} height={40} densities={[1, 2]} class="h-7 w-auto grayscale lg:h-8" />
            </div>
            <div class="min-w-0">
              <p class="text-white">{e.degree}</p>
              <p class="mt-0.5 text-sm text-mute">{e.years}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
