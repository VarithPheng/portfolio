---
import { sections } from "@/data/profile";

const keys = [
  ["1 – 4", "Jump to a section"],
  ["g", "Back to the top"],
  ["G", "Go to the bottom"],
  ["?", "Show or hide this list"],
];
---

<!-- Navigation as a tmux status line, fixed to the bottom of the screen. -->
<nav class="statusbar mono fixed inset-x-0 z-50" aria-label="Sections">
  <div class="shell relative">
    <div class="glass-strong absolute right-5 bottom-full mb-2 hidden w-64 rounded-lg p-3 lg:right-16" id="shortcuts" data-help>
      <p class="text-white">Keyboard shortcuts</p>
      <dl class="mt-2 grid grid-cols-[3.5rem_1fr] gap-y-1">
        {
          keys.map(([k, what]) => (
            <>
              <dt class="text-white">{k}</dt>
              <dd class="text-mute">{what}</dd>
            </>
          ))
        }
      </dl>
    </div>

    <div class="bar glass-strong flex h-9 items-stretch overflow-hidden rounded-lg">
      <a href="#top" class="flex items-center bg-white px-2.5 font-semibold text-ink lg:px-3">varith</a>
      <ul class="flex">
        {
          sections.map((s, i) => (
            <li class="flex">
              <a href={`#${s.id}`} class="tab flex items-center px-2 text-mute lg:px-3" data-spy={s.id}>
                {i + 1}:{s.label.toLowerCase()}
                <span class="star">*</span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="ml-auto hidden items-center px-3 text-mute lg:flex">phnom penh, cambodia</span>
      <button
        type="button"
        class="hidden items-center border-l border-white/10 px-3 text-mute hover:text-white lg:flex"
        aria-expanded="false"
        aria-controls="shortcuts"
        data-help-toggle
      >
        ? shortcuts
      </button>
    </div>
  </div>
</nav>

<style>
  .statusbar {
    bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  /* Denser than the usual glass so big type scrolling underneath doesn't show through. */
  .bar,
  [data-help] {
    background-color: rgb(12 12 12 / 0.85);
  }
  .tab {
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .tab:hover {
    color: var(--color-white);
  }
  /* tmux marks the current window with a star. */
  .star {
    visibility: hidden;
  }
  .tab[aria-current="true"] {
    background: rgb(255 255 255 / 0.12);
    color: var(--color-white);
  }
  .tab[aria-current="true"] .star {
    visibility: visible;
  }
  @media (max-width: 63.99rem) {
    .statusbar {
      font-size: 0.6875rem;
      font-stretch: 75%;
    }
  }
</style>

<script>
  import { sections } from "@/data/profile";

  // Highlight the section in view.
  const tabs = document.querySelectorAll<HTMLAnchorElement>("[data-spy]");
  const targets = sections.map((s) => document.getElementById(s.id)).filter((el) => el !== null);
  const pick = () => {
    // The active section is the last one whose top has passed the upper third of the screen.
    const line = window.innerHeight / 3;
    let current: HTMLElement | undefined;
    for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = targets.at(-1);
    tabs.forEach((t) => t.setAttribute("aria-current", String(t.dataset.spy === current?.id)));
  };
  pick();
  window.addEventListener("scroll", pick, { passive: true });
  window.addEventListener("resize", pick);

  // Shortcut list
  const help = document.querySelector<HTMLElement>("[data-help]")!;
  const toggle = document.querySelector<HTMLButtonElement>("[data-help-toggle]")!;
  const setHelp = (open: boolean) => {
    help.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
  };
  toggle.addEventListener("click", () => setHelp(help.classList.contains("hidden")));

  // Keyboard shortcuts, vim/tmux style. Ignored while typing in a field or with a modifier held.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const behavior = (): ScrollBehavior => (reduceMotion.matches ? "auto" : "smooth");
  document.addEventListener("keydown", (e) => {
    const el = e.target as HTMLElement;
    if (e.metaKey || e.ctrlKey || e.altKey || el.closest("input, textarea, select, [contenteditable]")) return;

    const n = Number(e.key);
    if (n >= 1 && n <= sections.length) {
      document.getElementById(sections[n - 1].id)?.scrollIntoView({ behavior: behavior() });
    } else if (e.key === "g") {
      window.scrollTo({ top: 0, behavior: behavior() });
    } else if (e.key === "G") {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: behavior() });
    } else if (e.key === "?") {
      setHelp(help.classList.contains("hidden"));
    } else if (e.key === "Escape") {
      setHelp(false);
    }
  });
</script>
