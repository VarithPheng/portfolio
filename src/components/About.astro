---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="about" title="3:about" meta="education" class="mt-16 lg:mt-24">
  <ul class="grid gap-3 lg:grid-cols-2 lg:gap-4">
    {
      education.map((e) => (
        <li class="flex items-center justify-center rounded-xl bg-white px-5 py-4 lg:py-5">
          <Image
            src={e.logo}
            alt={e.school}
            height={112}
            densities={[1, 2]}
            class="h-9 w-auto max-w-full lg:h-12"
          />
        </li>
      ))
    }
  </ul>
</Pane>
