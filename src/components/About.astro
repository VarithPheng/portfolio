---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="about" title="3:about" class="mt-16 lg:mt-24">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="max-w-[56ch] text-lg text-white lg:text-xl">
        I'm a developer in Phnom Penh studying for two degrees at once: IT management at AUPP and computer
        science at Fort Hays State. I like work that touches the real world, like getting a payment from a
        Cambodian bank app all the way to a confirmed order.
      </p>

      </div>

    <div class="lg:col-span-5">
      <h3 class="mono text-mute">education</h3>
      <ul class="mt-3 divide-y divide-white/10 border-y border-white/10">
        {
          education.map((e) => (
            <li class="flex flex-col items-start gap-3 py-5">
              <div class="shrink-0 rounded-xl bg-white px-3 py-2">
                <Image src={e.logo} alt={e.school} height={40} densities={[1, 2]} class="h-7 w-auto" />
              </div>
              <div>
                <p class="text-white">{e.degree}</p>
                <p class="mt-0.5 text-sm text-mute">{e.school}</p>
              </div>
              <p class="mono text-mute">{e.years}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Pane>
