---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="about" title="3:about" meta="education" class="mt-16 lg:mt-24">
  <ul class="flex flex-wrap gap-3 lg:gap-4">
    {
      education.map((e) => (
        <li class="rounded-xl bg-white px-4 py-3 lg:px-5 lg:py-4">
          <Image src={e.logo} alt={e.school} height={96} densities={[1, 2]} class="h-10 w-auto lg:h-12" />
        </li>
      ))
    }
  </ul>
</Pane>
