---
import { Image } from "astro:assets";
import { education } from "@/data/profile";
import Pane from "@/components/Pane.astro";
---

<Pane id="about" title="3:about" meta="education" class="mt-16 lg:mt-24">
  <ul class="-my-3 divide-y divide-white/10 lg:-my-4">
    {
      education.map((e) => (
        <li class="flex items-center justify-between gap-4 py-4 lg:py-5">
          <div class="rounded-lg bg-white px-3 py-2 lg:px-4 lg:py-2.5">
            <Image src={e.logo} alt={e.school} height={96} densities={[1, 2]} class="h-8 w-auto lg:h-10" />
          </div>
          <p class="mono shrink-0 text-paper">{e.years}</p>
        </li>
      ))
    }
  </ul>
</Pane>
