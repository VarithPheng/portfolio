---
import { Icon } from "astro-icon/components";
import { tools } from "@/data/profile";

// Two rows of logos running in opposite directions. A row of logos is narrower than the
// box, so each row is rendered four times; scrolling by half keeps the loop seamless.
const half = Math.ceil(tools.length / 2);
const rows = [
  { tools: tools.slice(0, half), reverse: false },
  { tools: tools.slice(half), reverse: true },
];
---

<div class="shell">
<div class="glass overflow-hidden rounded-[1.75rem] py-6 lg:py-8">
<div class="marquee" aria-hidden="true">
  {
    rows.map((row) => (
      <div class:list={["track", row.reverse && "reverse"]}>
        {[0, 1, 2, 3].map(() => (
          <ul class="group">
            {row.tools.map((t) => (
              <li title={t.name}>
                <Icon name={t.icon} class="size-10 text-white/85 lg:size-12" />
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
</div>
</div>
</div>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .track + .track {
    margin-top: 1.75rem;
  }
  .reverse {
    animation-direction: reverse;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .group {
    display: flex;
    gap: 3.5rem;
    padding-right: 3.5rem;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  /* Static, scrollable row for people who turn off motion. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
    }
    .track {
      animation: none;
    }
    .group + .group {
      display: none;
    }
  }
</style>
